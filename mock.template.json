"<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>전산 모의고사 5회</title><style>\n:root{--blue:#155fa8;--ink:#17283e;--line:#d0deec;--good:#176b42;--bad:#b33232}*{box-sizing:border-box}body{margin:0;background:#f3f6fa;color:var(--ink);font:16px/1.8 'Malgun Gothic',Arial,sans-serif}main{max-width:1180px;margin:auto;padding:28px 22px 70px}h1{font-size:30px;margin:8px 0}h2{font-size:23px;line-height:1.6}h3{font-size:18px}a{color:var(--blue)}nav,.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}nav a{padding:7px 12px;background:white;border:1px solid var(--line);border-radius:6px;text-decoration:none}.panel{background:white;border:1px solid var(--line);border-radius:12px;padding:22px;margin:20px 0}.muted{color:#607287}.small{font-size:13px}button{font:inherit;cursor:pointer;border:1px solid #abc0d7;border-radius:7px;background:white;color:var(--ink);padding:9px 14px}button:hover{background:#eaf3fd}button.primary{background:var(--blue);color:white;border-color:var(--blue)}button:disabled{opacity:.5;cursor:default}.rounds{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.round-card{background:white;border:1px solid var(--line);border-radius:12px;padding:18px;display:flex;flex-direction:column;gap:10px}.round-card h2{margin:0}.round-card button{width:100%}.badge{display:inline-flex;gap:8px;align-items:center;padding:9px 15px;background:#e5f2e9;border:1px solid #a4ceb2;color:#165c39;border-radius:24px;font-weight:bold}.badge.empty{background:#edf1f6;border-color:#d0dae5;color:#687a8d;font-weight:normal}.badges{display:flex;gap:10px;flex-wrap:wrap}.score{font-size:38px;font-weight:bold;line-height:1.4}.layout{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:20px}.stem{background:#f5f8fc;border-radius:8px;padding:18px;white-space:pre-wrap;line-height:2}.choices{display:grid;gap:11px;margin:20px 0}.choice{display:flex;gap:12px;align-items:flex-start;border:1px solid #cbd8e6;border-radius:8px;padding:14px;cursor:pointer}.choice input{margin-top:8px;accent-color:var(--blue)}.choice:has(input:checked){background:#eaf3fd;border-color:var(--blue)}.choice.correct{background:#edf8f1;border:2px solid var(--good)}.choice.wrong{background:#fff1f1;border:2px solid var(--bad)}.choice span{white-space:pre-wrap}.navgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.navgrid button{font-size:13px;padding:6px 0}.navgrid .current{outline:2px solid var(--blue)}.navgrid .answered{background:#dbeafb}.navgrid .right{background:#dff2e5}.navgrid .wrong{background:#ffe0e0}.progress{height:7px;background:#dce5ef;border-radius:4px;margin:12px 0}.progress span{height:100%;display:block;background:var(--blue);border-radius:4px}#timer{font-size:23px;font-weight:bold;font-variant-numeric:tabular-nums}.tag{font-size:13px;background:#eaf3fd;border-radius:16px;padding:3px 10px}.explain{white-space:pre-wrap;border-top:1px solid var(--line);padding-top:14px;margin-top:20px}.correctText{color:var(--good)}.wrongText{color:var(--bad)}.code-panel{background:#172131;color:#e1e9f3;border-radius:9px;margin:18px 0;overflow:hidden}.code-toolbar{font:13px Consolas,monospace;background:#233044;padding:10px 15px}.code-panel pre{margin:0;overflow-x:auto;padding:12px 0;font:15px/1.9 Consolas,'Courier New',monospace;counter-reset:line}.code-line{display:block;min-width:max-content;padding-right:20px}.code-line:before{counter-increment:line;content:counter(line);display:inline-block;text-align:right;width:40px;margin-right:16px;padding-right:10px;color:#91a3bb;border-right:1px solid #35445a}.rel-symbol{font-family:'Cambria Math','Segoe UI Symbol',serif;font-size:1.45em;line-height:1;display:inline-block;vertical-align:-.06em}.math-power{font:600 .9em Arial,sans-serif;position:relative;top:-.42em;vertical-align:baseline;line-height:0}sub.math-sub{font:.9em Arial,sans-serif}.question-figure{padding:15px;border:1px solid var(--line);border-radius:8px;margin:16px 0;overflow-x:auto}.question-svg{width:100%;max-width:560px;display:block;margin:auto}.question-svg text{font:17px 'Malgun Gothic',sans-serif;fill:#17283e}.question-svg .edge{stroke:#59728d;stroke-width:2;fill:none}.question-svg .node{fill:#edf4fc;stroke:#2c608f;stroke-width:2}.data-figure{border-collapse:collapse;margin:6px auto;min-width:180px}.data-figure th,.data-figure td{border:1px solid #b6c8dc;padding:8px 14px;text-align:center}.data-figure th{background:#eaf1f9}.data-figure caption{font-weight:bold;margin-bottom:6px}.figure-tables{display:flex;flex-wrap:wrap;gap:24px;justify-content:center}.history{width:100%;border-collapse:collapse;font-size:14px}.history th,.history td{padding:10px;border-bottom:1px solid var(--line);text-align:left}.history th{background:#f0f4fa}[hidden]{display:none!important}#storageNotice{color:#9b402a}.notice{padding:14px 18px;background:#edf4fc;border-radius:8px;margin:16px 0}#resultPanel{border-color:#9ebcdb}.result-summary{display:grid;grid-template-columns:1fr auto;gap:15px;align-items:center}.subject-summary{display:flex;gap:12px;flex-wrap:wrap;font-size:14px}.subject-summary span{background:#f0f4fa;padding:5px 10px;border-radius:5px}@media(max-width:1000px){.rounds{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.layout{grid-template-columns:1fr}.rounds{grid-template-columns:repeat(2,1fr)}main{padding:20px 12px}.panel{padding:17px}.result-summary{grid-template-columns:1fr}.code-panel pre{font-size:14px}.stem{padding:14px}h1{font-size:26px}}@media(max-width:400px){.rounds{grid-template-columns:1fr}}\n.badge-group{display:flex;align-items:flex-start;gap:12px;flex:1 1 100%;padding:10px 0;border-bottom:1px solid var(--line)}.badge-group>b{white-space:nowrap;min-width:55px}.attempt-list{display:flex;flex-wrap:wrap;gap:6px}.attempt-badge{font-size:12px;padding:3px 9px;white-space:nowrap}button.attempt-badge:hover{background:#c9e8d4;outline:2px solid #72a98a}.archive-label{background:#eaf3fd;padding:9px 13px;border-radius:6px}.option-reasons p{white-space:pre-wrap}.option-reasons details{margin:8px 0;border:1px solid #d7e1ec;padding:8px 12px;border-radius:6px}.verified-refs a{display:block;margin:8px 0}\nbody{padding-bottom:env(safe-area-inset-bottom)}input,select,textarea{font-size:16px}svg{max-width:100%;height:auto}table{display:block;max-width:100%;overflow-x:auto}pre{max-width:100%;overflow-x:auto}@media(max-width:600px){main{padding:16px 12px}.panel{padding:16px}.choice{min-height:48px}.layout{display:block}h1{font-size:25px}.stem{font-size:17px}}\n</style><main><p><a href=\"index.html\">← 내 학습자료 관리</a></p><header><h1>전산 모의고사</h1><p class=\"muted\">5회 × 20문항 · 회차당 30분 · 문항당 5점 · 제출 후 정답·해설 공개</p><nav><a href=\"필기후기_연습시험.html\">연습문제 140문항</a><a href=\"학습자료_색인.html\">교재 색인</a><a href=\"필기후기_분석보고서.html\">후기 분석</a></nav></header><p id=\"storageNotice\" role=\"status\"></p><section class=\"panel\"><div class=\"row between\"><h2>내 점수 배지</h2><button id=\"exportScores\">점수 기록 내려받기</button></div><div id=\"badges\" class=\"badges\" aria-live=\"polite\"></div><p class=\"small muted\">각 모의고사 옆에 1차·2차·3차 응시 점수가 차례로 쌓입니다. 낮은 점수도 이전 배지를 대체하지 않습니다. 기록은 현재 PC·브라우저에 저장됩니다.</p></section><section id=\"home\"><h2>응시할 회차 선택</h2><p class=\"small muted\">기존 연습문제의 개념을 변형하고 새로운 상황·수치·코드를 설계한 창작 모의고사입니다. 공식 기출 원문은 아닙니다.</p><div id=\"rounds\" class=\"rounds\"></div><section class=\"panel\"><h2>응시 기록</h2><div id=\"history\"></div></section></section><section id=\"exam\" hidden><div class=\"row between\"><h2 id=\"examTitle\"></h2><div class=\"row\"><span id=\"timer\"></span><button id=\"backHome\">회차 선택으로</button></div></div><div id=\"resultPanel\" class=\"panel\" hidden></div><div class=\"row between\"><b id=\"position\"></b><span id=\"answered\"></span></div><div class=\"progress\"><span id=\"progress\"></span></div><div class=\"layout\"><article class=\"panel\"><span id=\"topic\" class=\"tag\"></span><h2 id=\"questionTitle\"></h2><div id=\"stem\" class=\"stem\"></div><figure id=\"figure\" class=\"question-figure\" hidden></figure><section id=\"codePanel\" class=\"code-panel\" hidden><div id=\"language\" class=\"code-toolbar\"></div><pre><code id=\"code\"></code></pre></section><div id=\"choices\" class=\"choices\"></div><div class=\"row between\"><button id=\"prev\">이전</button><button id=\"next\" class=\"primary\">다음</button></div><section id=\"explanation\" class=\"explain\" hidden><b id=\"answerLabel\"></b><h3>풀이·해설</h3><div id=\"explainText\"></div></section><div class=\"row between notice\"><span id=\"submitNotice\"></span><button id=\"submit\">답안 제출·채점</button></div></article><aside class=\"panel\"><h3>문제 이동</h3><div id=\"nav\" class=\"navgrid\"></div><p class=\"small muted\">파랑: 응답 · 제출 후 초록: 정답, 빨강: 오답</p><p id=\"saveStatus\" class=\"small muted\"></p></aside></div></section></main><script id=\"mockdata\" type=\"application/json\">__PRIVATE_BANK__</script><script>\nconst BANK=JSON.parse(document.getElementById('mockdata').textContent),$=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst KEY='computer-mock-five-v1',Q=new Map(BANK.questions.map(q=>[q.id,q]));let active=null,state={version:1,sessions:{},history:[]},storageOK=true;\ntry{const stored=JSON.parse(localStorage.getItem(KEY)||'null');if(stored&&stored.version===1&&stored.sessions&&Array.isArray(stored.history))state=stored;}catch(e){storageOK=false;}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(state));storageOK=true;}catch(e){storageOK=false;}$('saveStatus').textContent=storageOK?'현재 브라우저에 자동 저장됨':'저장 불가 · 현재 창에서만 유지';$('storageNotice').textContent=storageOK?'':'브라우저 저장소를 사용할 수 없습니다. 기록을 내려받아 보관하세요.';}\nfunction prose(value){const map={'⁰':'0','¹':'1','²':'2','³':'3','⁴':'4','⁵':'5','⁶':'6','⁷':'7','⁸':'8','⁹':'9','⁻':'−'};return esc(value).replace(/[⁰¹²³⁴⁵⁶⁷⁸⁹⁻]+/g,x=>'<sup class=\"math-power\">'+[...x].map(c=>map[c]).join('')+'</sup>').replace(/π_이름/g,'π<sub class=\"math-sub\">이름</sub>').replace(/σ_학과=전산/g,'σ<sub class=\"math-sub\">학과=전산</sub>').replace(/[σπ⋈∪∩÷×]/g,c=>'<span class=\"rel-symbol\">'+c+'</span>');}\nfunction roundQuestions(id){return BANK.questions.filter(q=>q.round===Number(id));}\nfunction reviewQuestions(id){const s=state.sessions[id],all=roundQuestions(id);return s?.submitted&&s.reviewWrong?all.filter(q=>s.answers[q.id]!==q.answer):all;}\nfunction setWrongReview(id,enabled){const s=sessionFor(id);if(!s?.submitted)return;const wrong=roundQuestions(id).filter(q=>s.answers[q.id]!==q.answer);s.reviewWrong=!!enabled&&wrong.length>0;s.index=0;active=Number(id);save();renderQuestion();$('position').scrollIntoView({behavior:'smooth'});}\nfunction latest(id){return [...state.history].reverse().find(h=>h.round===Number(id));}\nfunction attemptBadges(id){const hs=state.history.filter(h=>h.round===Number(id));return hs.length?hs.map((h,i)=>'<button type=\"button\" class=\"badge attempt-badge\" data-run=\"'+esc(h.runId)+'\" title=\"'+esc(new Date(h.at).toLocaleString('ko-KR'))+'\">'+(i+1)+'차 '+h.score+'점</button>').join(''):'<span class=\"small muted\">미응시</span>';}\nfunction renderBadges(){$('badges').innerHTML=BANK.rounds.map(r=>'<div class=\"badge-group\"><b>'+r.id+'회차</b><div class=\"attempt-list\">'+attemptBadges(r.id)+'</div></div>').join('');}\nfunction renderHome(){renderBadges();$('rounds').innerHTML=BANK.rounds.map(r=>{let s=state.sessions[r.id],h=latest(r.id),running=s&&!s.submitted;return '<article class=\"round-card\"><h2>'+r.title+'</h2><span class=\"muted\">'+r.count+'문항 · '+r.minutes+'분</span>'+'<div class=\"attempt-list\">'+attemptBadges(r.id)+'</div>'+'<button class=\"primary\" data-start=\"'+r.id+'\">'+(running?'이어서 풀기':h?'답안·해설 보기':'시험 시작')+'</button>'+(h?'<button data-retry=\"'+r.id+'\">새로 응시</button>':'')+'</article>';}).join('');document.querySelectorAll('[data-start]').forEach(b=>b.onclick=()=>openRound(Number(b.dataset.start)));document.querySelectorAll('[data-retry]').forEach(b=>b.onclick=()=>openRound(Number(b.dataset.retry),true));$('history').innerHTML=state.history.length?'<table class=\"history\"><thead><tr><th>회차</th><th>점수</th><th>정답</th><th>제출 일시</th></tr></thead><tbody>'+[...state.history].reverse().map(h=>'<tr><td>'+h.round+'회차 · '+h.attempt+'차 응시</td><td>'+h.score+'점</td><td>'+h.correct+'/'+h.total+'</td><td>'+esc(new Date(h.at).toLocaleString('ko-KR'))+'</td></tr>').join('')+'</tbody></table>':'<p class=\"muted\">제출하면 회차별 점수가 이곳과 배지에 저장됩니다.</p>';}\nfunction openRound(id,fresh=false){active=id;let s=state.sessions[id];if(!s||fresh){const r=BANK.rounds.find(r=>r.id===id);s=state.sessions[id]={runId:Date.now()+'-'+id+'-'+Math.random().toString(36).slice(2,8),round:id,index:0,answers:{},startedAt:Date.now(),endAt:Date.now()+r.minutes*60000,submitted:false};save();}if(s.reviewWrong){s.reviewWrong=false;s.index=0;}if(!s.submitted&&Date.now()>=s.endAt)finalize(id,true);$('home').hidden=true;$('exam').hidden=false;renderQuestion();tick();$('exam').scrollIntoView({behavior:'smooth'});}\nfunction finalize(id,auto=false){const s=state.sessions[id];if(!s||s.submitted)return;const qs=roundQuestions(id),correct=qs.filter(q=>s.answers[q.id]===q.answer).length;s.submitted=true;s.finishedAt=Date.now();s.auto=auto;const result={runId:s.runId,round:id,score:Math.round(correct/qs.length*100),correct,total:qs.length,at:s.finishedAt,attempt:state.history.filter(h=>h.round===id).length+1,answers:{...s.answers}};if(!state.history.some(h=>h.runId===s.runId))state.history.push(result);save();renderBadges();}\nfunction submit(){if(active===null)return;finalize(active);renderQuestion();$('resultPanel').scrollIntoView({behavior:'smooth'});}\nfunction renderResult(s,qs){$('resultPanel').hidden=!s.submitted;if(!s.submitted)return;const h=state.history.find(h=>h.runId===s.runId),topics=[...new Set(qs.map(q=>q.topic))],wrong=qs.filter(q=>s.answers[q.id]!==q.answer).length;$('resultPanel').innerHTML='<div class=\"result-summary\"><div><b>'+s.round+'회차 '+(s.auto?'시간 종료 · 자동 채점':'채점 완료')+'</b><div class=\"score\">'+h.score+'점</div><p>'+h.correct+'/'+h.total+'문항 정답 · 점수 배지에 저장했습니다.</p></div><button id=\"retryCurrent\" class=\"primary\">이 회차 다시 응시</button></div><div class=\"row notice\"><button id=\"reviewWrong\" '+(wrong?'':'disabled')+'>'+(s.reviewWrong?'전체 20문항 보기':'틀린 문제만 다시 보기 ('+wrong+'개)')+'</button><span class=\"small muted\">'+(wrong?'미응답 포함 · 정답과 해설을 복습합니다.':'모든 문제를 맞혔습니다.')+'</span></div><div class=\"subject-summary\">'+topics.map(t=>{const a=qs.filter(q=>q.topic===t);return '<span>'+esc(t)+' '+a.filter(q=>s.answers[q.id]===q.answer).length+'/'+a.length+'</span>';}).join('')+'</div>';$('retryCurrent').onclick=()=>openRound(s.round,true);$('reviewWrong').onclick=()=>setWrongReview(s.round,!s.reviewWrong);}\nfunction renderQuestion(){if(active===null)return;const s=currentSession(),qs=reviewQuestions(active),q=qs[s.index],done=qs.filter(q=>Number.isInteger(s.answers[q.id])).length;renderBadges();$('examTitle').textContent=active+'회차 '+(s.reviewWrong?'오답 복습':'모의고사');$('position').textContent=(s.reviewWrong?'오답 ':'')+(s.index+1)+' / '+qs.length+(s.reviewWrong?' · 원래 '+(roundQuestions(active).findIndex(v=>v.id===q.id)+1)+'번':'');$('answered').textContent=s.reviewWrong?'미응답 포함 · 점수·배지 변경 없음':'응답 '+done+'/'+qs.length;$('progress').style.width=(100*done/qs.length)+'%';$('topic').textContent=q.topic;$('questionTitle').textContent=s.submitted?q.title:'문제 '+(s.index+1);$('stem').innerHTML=prose(q.stem);$('figure').hidden=!q.visual_html;$('figure').innerHTML=q.visual_html||'';$('codePanel').hidden=!q.code;$('language').textContent=(q.language||'')+' · 읽기 전용';$('code').innerHTML=q.code?q.code.split('\\n').map(x=>'<span class=\"code-line\">'+(esc(x)||' ')+'</span>').join(''):'';$('choices').innerHTML=q.options.map((o,i)=>'<label class=\"choice '+(s.submitted&&i===q.answer?'correct ':'')+(s.submitted&&s.answers[q.id]===i&&i!==q.answer?'wrong':'')+'\"><input type=\"radio\" name=\"option\" value=\"'+i+'\" '+(s.answers[q.id]===i?'checked ':'')+(s.submitted?'disabled':'')+'><span><b>'+(i+1)+'.</b> '+prose(o)+(s.submitted&&i===q.answer?' ✓ 정답':'')+'</span></label>').join('');document.querySelectorAll('input[name=option]').forEach(input=>input.onchange=()=>{if(s.submitted)return;if(Date.now()>=s.endAt){finalize(active,true);renderQuestion();return;}s.answers[q.id]=Number(input.value);save();renderQuestion();});$('prev').disabled=s.index===0;$('next').disabled=s.index===qs.length-1;$('explanation').hidden=!s.submitted;if(s.submitted){const right=s.answers[q.id]===q.answer;$('answerLabel').textContent=(right?'정답':'오답'+(s.answers[q.id]===undefined?' · 미응답':''))+' · 정답 '+(q.answer+1)+'번';$('answerLabel').className=right?'correctText':'wrongText';$('explainText').innerHTML=prose(q.explanation);}$('submit').hidden=s.submitted;$('submit').textContent='답안 제출·채점'+(done<qs.length?' (미응답 '+(qs.length-done)+')':'');$('submitNotice').textContent=s.submitted?'아래 해설과 문제 이동에서 오답을 복습하세요.':'미응답은 오답 처리됩니다. 제출 후 해설이 공개됩니다.';$('nav').innerHTML=qs.map((q,i)=>{let cls=i===s.index?'current ':'';cls+=s.submitted?(s.answers[q.id]===q.answer?'right':'wrong'):(Number.isInteger(s.answers[q.id])?'answered':'');return '<button data-index=\"'+i+'\" class=\"'+cls+'\">'+(s.reviewWrong?roundQuestions(active).findIndex(v=>v.id===q.id)+1:i+1)+'</button>';}).join('');document.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>{s.index=Number(b.dataset.index);save();renderQuestion();});renderResult(s,roundQuestions(active));$('saveStatus').textContent=storageOK?'현재 브라우저에 자동 저장됨':'현재 창에서만 기록 유지';}\nfunction tick(){let changed=false;for(const [id,s] of Object.entries(state.sessions)){if(!s.submitted&&Date.now()>=s.endAt){finalize(Number(id),true);changed=true;}}if(changed){if(active!==null&&!$('exam').hidden)renderQuestion();else renderHome();}if(active===null||$('exam').hidden)return;const s=currentSession();if(s.submitted){$('timer').textContent='제출 완료';return;}const sec=Math.max(0,Math.ceil((s.endAt-Date.now())/1000));$('timer').textContent=Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');}\n$('prev').onclick=()=>{currentSession().index--;save();renderQuestion();};$('next').onclick=()=>{currentSession().index++;save();renderQuestion();};$('submit').onclick=submit;$('backHome').onclick=()=>{active=null;$('exam').hidden=true;$('home').hidden=false;save();renderHome();};$('exportScores').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify({title:BANK.title,exportedAt:new Date().toISOString(),history:state.history},null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='모의고사_점수기록.json';a.click();URL.revokeObjectURL(url);};renderHome();tick();setInterval(()=>tick(),1000);\n// Older results and wrong-answer practice are views; official history is append-only on exam submission.\nlet archivedSession=null,retrySession=null;\nfunction sessionFor(id){return active===Number(id)?(retrySession||archivedSession||state.sessions[id]):state.sessions[id];}\nfunction currentSession(){return sessionFor(active);}\nfunction openAttempt(runId){\n    const h=state.history.find(v=>v.runId===runId);if(!h)return;\n    retrySession=null;active=h.round;\n    archivedSession={round:h.round,runId:h.runId,index:0,answers:{...h.answers},submitted:true,finishedAt:h.at,attempt:h.attempt,archived:true};\n    $('home').hidden=true;$('exam').hidden=false;renderQuestion();tick();$('exam').scrollIntoView({behavior:'smooth'});\n}\nfunction startWrongPractice(){\n    const source=currentSession();if(!source?.submitted||source.retry)return;\n    const ids=roundQuestions(active).filter(q=>source.answers[q.id]!==q.answer).map(q=>q.id);if(!ids.length)return;\n    const s={round:active,runId:'review-'+Date.now(),sourceRunId:source.runId,ids,index:0,answers:{},submitted:false,retry:true,endAt:Date.now()+315360000000};\n    archivedSession=null;retrySession=state.reviewPractice=s;save();renderQuestion();\n}\nfunction gradeWrongPractice(){\n    if(!retrySession||retrySession.submitted)return;\n    retrySession.submitted=true;retrySession.finishedAt=Date.now();save();renderQuestion();$('resultPanel').scrollIntoView({behavior:'smooth'});\n}\nfunction finishPracticeView(){const id=retrySession?.sourceRunId;retrySession=null;if(id)openAttempt(id);}\nfunction bindAttemptBadges(){document.querySelectorAll('[data-run]').forEach(b=>b.onclick=()=>openAttempt(b.dataset.run));}\nfunction optionReasonHtml(q,answer){\n    const rs=q.option_explanations||[];if(!rs.length)return '';\n    return '<div class=\"option-reasons\"><h3>보기별 해설</h3>'+rs.map((reason,i)=>'<details '+(answer===i?'open':'')+'><summary>'+(i+1)+'번 '+(i===q.answer?'· 정답':answer===i?'· 내가 고른 오답':'')+'</summary><p>'+prose(reason)+'</p></details>').join('')+'</div>';\n}\nfunction referenceHtml(q){return (q.verified_references||[]).length?'<div class=\"verified-refs\"><h3>확인한 교재 근거</h3>'+q.verified_references.map(r=>'<a href=\"'+esc(r.url)+'\" target=\"_blank\" rel=\"noopener\">'+esc(r.book)+' · PDF p.'+r.page+' · '+esc(r.section)+'</a><p class=\"small muted\">'+esc(r.scope)+'</p>').join('')+'</div>':'';}\nconst originalReviewQuestions=reviewQuestions;\nreviewQuestions=function(id){const s=sessionFor(id);if(s?.retry)return s.ids.map(id=>Q.get(id));const all=roundQuestions(id);return s?.submitted&&s.reviewWrong?all.filter(q=>s.answers[q.id]!==q.answer):all;};\nconst originalOpenRound=openRound;\nopenRound=function(id,fresh=false){archivedSession=null;retrySession=null;return originalOpenRound(id,fresh);};\nconst originalRenderBadges=renderBadges;\nrenderBadges=function(){originalRenderBadges();bindAttemptBadges();};\nconst originalRenderHome=renderHome;\nrenderHome=function(){originalRenderHome();bindAttemptBadges();\n    if(state.reviewPractice&&!state.reviewPractice.submitted){const s=state.reviewPractice;$('history').innerHTML='<button id=\"resumeReview\">'+s.round+'회차 오답 재풀이 이어하기</button>'+$('history').innerHTML;$('resumeReview').onclick=()=>{archivedSession=null;retrySession=state.reviewPractice;active=retrySession.round;$('home').hidden=true;$('exam').hidden=false;renderQuestion();};}\n};\nconst originalRenderResult=renderResult;\nrenderResult=function(s,qs){\n    if(s.retry){\n        $('resultPanel').hidden=!s.submitted;if(!s.submitted)return;\n        const selected=s.ids.map(id=>Q.get(id)),n=selected.filter(q=>s.answers[q.id]===q.answer).length;\n        $('resultPanel').innerHTML='<h2>오답 재풀이 결과 · '+n+'/'+selected.length+'개 정답</h2><p>모의고사 점수·배지는 바뀌지 않았습니다.</p><button id=\"returnAttempt\">원래 응시 결과 보기</button><button id=\"retryReview\">다시 가리고 풀기</button>';\n        $('returnAttempt').onclick=finishPracticeView;$('retryReview').onclick=()=>{s.answers={};s.index=0;s.submitted=false;save();renderQuestion();};return;\n    }\n    originalRenderResult(s,qs);\n    if(s.submitted){\n        const wrong=roundQuestions(s.round).filter(q=>s.answers[q.id]!==q.answer).length;\n        $('resultPanel').insertAdjacentHTML('beforeend','<div class=\"row\"><button id=\"practiceWrong\" class=\"primary\" '+(wrong?'':'disabled')+'>정답 가리고 오답 다시 풀기 ('+wrong+'개)</button></div>');\n        $('practiceWrong').onclick=startWrongPractice;\n        if(s.archived)$('resultPanel').insertAdjacentHTML('afterbegin','<p class=\"archive-label\">'+s.attempt+'차 응시 당시의 답안입니다. 현재 진행 중인 시험은 유지됩니다.</p>');\n    }\n};\nconst originalRenderQuestion=renderQuestion;\nrenderQuestion=function(){\n    if(active===null)return;const s=currentSession(),qs=reviewQuestions(active);s.index=Math.max(0,Math.min(s.index,qs.length-1));\n    originalRenderQuestion();const q=qs[s.index];\n    if(s.submitted)$('explainText').insertAdjacentHTML('beforeend',optionReasonHtml(q,s.answers[q.id])+referenceHtml(q));\n    if(s.archived)$('examTitle').textContent=s.round+'회차 · '+s.attempt+'차 응시 답안';\n    if(s.retry){\n        $('examTitle').textContent=s.round+'회차 · 오답 재풀이';$('position').textContent='복습 '+(s.index+1)+' / '+qs.length+' · 원래 '+(roundQuestions(active).findIndex(v=>v.id===q.id)+1)+'번';\n        $('submitNotice').textContent='별도 복습입니다. 원래 점수·배지는 유지됩니다.';$('submit').textContent='오답 재풀이 채점';\n        document.querySelectorAll('[data-index]').forEach(b=>{const view=qs[Number(b.dataset.index)];b.textContent=roundQuestions(active).findIndex(v=>v.id===view.id)+1;});\n    }\n};\nconst originalSubmit=submit;\nsubmit=function(){if(retrySession){gradeWrongPractice();return;}if(archivedSession)return;originalSubmit();};\nconst originalTick=tick;\ntick=function(){originalTick();if(retrySession)$('timer').textContent='오답 연습 · 시간 제한 없음';};\n$('submit').onclick=()=>submit();\n$('backHome').onclick=()=>{active=null;archivedSession=null;retrySession=null;$('exam').hidden=true;$('home').hidden=false;save();renderHome();};\nrenderHome();\n\nfunction renderQualityProfiles(){\n    const rows=BANK.quality_profiles||[];if(!rows.length)return;\n    let panel=document.getElementById('qualityProfiles');if(!panel){panel=document.createElement('details');panel.id='qualityProfiles';panel.className='panel';document.getElementById('home').appendChild(panel);}\n    const domains=['컴퓨터구조','운영체제','데이터베이스','자료구조','네트워크','정보보안','프로그래밍','소프트웨어공학'];\n    panel.innerHTML='<summary>회차별 영역·난이도 구성 보기</summary><p class=\"small muted\">난이도는 편성 기준입니다. 실제 정답률로 보정한 난이도는 아니며 회차 점수가 같은 실력을 뜻한다고 단정할 수 없습니다.</p><div style=\"overflow-x:auto\"><table class=\"history\"><thead><tr><th>회차</th>'+domains.map(d=>'<th>'+d+'</th>').join('')+'<th>하 / 중</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+r.round+'회차</td>'+domains.map(d=>'<td>'+(r.domains[d]||0)+'</td>').join('')+'<td>'+(r.editorial_difficulty['하']||0)+' / '+(r.editorial_difficulty['중']||0)+'</td></tr>').join('')+'</tbody></table></div>';\n}\nconst homeWithLearning=renderHome;renderHome=function(){homeWithLearning();renderQualityProfiles();};renderHome();\n\nfunction onStudyRecordsRestored(){state=JSON.parse(localStorage.getItem(KEY)||'null')||{version:1,sessions:{},history:[]};active=null;archivedSession=null;retrySession=null;$('exam').hidden=true;$('home').hidden=false;renderHome();}\nconst STUDY_CATALOG=__PRIVATE_CATALOG__;const STUDY_FINGERPRINT=__PRIVATE_FINGERPRINT__;// Standalone pages have browser-scoped storage. Backups contain only records accessible from this page.\nconst STUDY_KEYS=['cafe-practice-v2','computer-mock-five-v1'];\nfunction backupAssert(ok,message){if(!ok)throw new Error(message);}\nfunction plainObject(v){return !!v&&typeof v==='object'&&!Array.isArray(v)&&Object.getPrototypeOf(v)===Object.prototype;}\nfunction safeAnswers(value,round=null,practice=false){\n    backupAssert(plainObject(value),'답안 형식이 올바르지 않습니다.');const out={};\n    for(const [id,a] of Object.entries(value)){\n        const q=STUDY_CATALOG[id];backupAssert(q&&(round===null||q.round===round),'알 수 없는 문항이 있습니다: '+id);\n        backupAssert((practice&&q.written&&typeof a==='string'&&a.length<=30000)||(!q.written&&Number.isInteger(a)&&a>=0&&a<q.count),'유효하지 않은 답안: '+id);\n        out[id]=a;\n    }return out;\n}\nfunction safeTime(v){return Number.isFinite(v)&&v>=0&&v<1e14;}\nfunction validateMock(value){\n    backupAssert(plainObject(value)&&value.version===1&&plainObject(value.sessions)&&Array.isArray(value.history),'모의고사 기록 형식을 확인하세요.');\n    backupAssert(value.history.length<=20000,'응시 기록이 너무 큽니다.');\n    const history=value.history.map(h=>{\n        backupAssert(plainObject(h)&&Number.isInteger(h.round)&&h.round>=1&&h.round<=5&&typeof h.runId==='string'&&h.runId.length<=160&&safeTime(h.at),'응시 기록의 회차·날짜가 올바르지 않습니다.');\n        const answers=safeAnswers(h.answers,h.round),qs=Object.entries(STUDY_CATALOG).filter(([id,q])=>q.round===h.round),correct=qs.filter(([id,q])=>answers[id]===q.answer).length;\n        backupAssert(h.total===qs.length&&h.correct===correct&&h.score===Math.round(100*correct/qs.length),'문제은행과 점수 기록이 일치하지 않습니다.');\n        return {runId:h.runId,round:h.round,answers,correct,total:qs.length,score:h.score,at:h.at,attempt:1};\n    });\n    backupAssert(new Set(history.map(h=>h.runId)).size===history.length,'중복 응시 ID가 있습니다.');\n    const sessions={};\n    for(const [id,s] of Object.entries(value.sessions)){\n        const round=Number(id);backupAssert(Number.isInteger(round)&&round>=1&&round<=5&&s.round===round&&plainObject(s),'저장된 시험 회차가 올바르지 않습니다.');\n        backupAssert(typeof s.runId==='string'&&s.runId.length<=160&&safeTime(s.startedAt)&&safeTime(s.endAt)&&Number.isInteger(s.index)&&s.index>=0&&s.index<20&&typeof s.submitted==='boolean','저장된 시험 상태가 올바르지 않습니다.');\n        if(s.submitted){const result=history.find(h=>h.runId===s.runId&&h.round===round);backupAssert(result,'제출 답안에 대응하는 점수 기록이 없습니다.');backupAssert(JSON.stringify(Object.entries(s.answers).sort())===JSON.stringify(Object.entries(result.answers).sort()),'제출 답안과 응시 기록이 일치하지 않습니다.');}\n        sessions[id]={round,runId:s.runId,index:s.index,answers:safeAnswers(s.answers,round),startedAt:s.startedAt,endAt:s.endAt,submitted:s.submitted,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined,auto:!!s.auto,reviewWrong:!!s.reviewWrong};\n    }\n    let reviewPractice;\n    if(value.reviewPractice){\n        const s=value.reviewPractice;backupAssert(plainObject(s)&&s.retry===true&&Array.isArray(s.ids)&&s.ids.length>0&&s.ids.length<=20&&new Set(s.ids).size===s.ids.length,'오답 복습 상태가 올바르지 않습니다.');\n        backupAssert(s.ids.every(id=>STUDY_CATALOG[id]?.round===s.round)&&Number.isInteger(s.index)&&s.index>=0&&s.index<s.ids.length&&history.some(h=>h.runId===s.sourceRunId),'오답 복습 문항·원본 응시를 확인하세요.');\n        const answers=safeAnswers(s.answers,s.round);backupAssert(Object.keys(answers).every(id=>s.ids.includes(id)),'복습 범위 밖 답안이 있습니다.');\n        reviewPractice={round:s.round,runId:String(s.runId).slice(0,160),sourceRunId:s.sourceRunId,ids:s.ids,index:s.index,answers,submitted:!!s.submitted,retry:true,endAt:safeTime(s.endAt)?s.endAt:Date.now()+315360000000,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined};\n    }\n    return {version:1,sessions,history,reviewPractice};\n}\nfunction validatePractice(v){\n    backupAssert(plainObject(v)&&plainObject(v.history)&&Array.isArray(v.stars),'연습문제 기록 형식을 확인하세요.');\n    const history={};for(const [id,h] of Object.entries(v.history)){\n        const q=STUDY_CATALOG[id];backupAssert(q&&!q.round&&!q.written&&plainObject(h)&&typeof h.correct==='boolean'&&safeTime(h.at),'연습 채점 기록이 올바르지 않습니다.');\n        backupAssert(h.answer===null||(Number.isInteger(h.answer)&&h.answer>=0&&h.answer<q.count),'연습 답안이 올바르지 않습니다.');\n        backupAssert(h.correct===(h.answer===q.answer),'연습 정오 기록이 문제은행과 다릅니다.');history[id]={correct:h.correct,answer:h.answer,at:h.at};\n    }\n    backupAssert(v.stars.every(id=>STUDY_CATALOG[id]&&!STUDY_CATALOG[id].round),'복습 표시 문항이 올바르지 않습니다.');\n    let session=null;\n    if(v.session){\n        const s=v.session;backupAssert(plainObject(s)&&Array.isArray(s.ids)&&s.ids.length>0&&new Set(s.ids).size===s.ids.length&&s.ids.every(id=>STUDY_CATALOG[id]&&!STUDY_CATALOG[id].round),'연습 세션 문항이 올바르지 않습니다.');\n        backupAssert(Number.isInteger(s.index)&&s.index>=0&&s.index<s.ids.length&&['exam','practice'].includes(s.mode)&&safeTime(s.startedAt)&&(s.endAt===null||safeTime(s.endAt)),'연습 세션 상태가 올바르지 않습니다.');\n        const answers=safeAnswers(s.answers,null,true);backupAssert(Object.keys(answers).every(id=>s.ids.includes(id)),'세션 범위 밖 답안이 있습니다.');\n        const checked={},self={};for(const [id,value] of Object.entries(s.checked||{})){backupAssert(s.ids.includes(id)&&typeof value==='boolean','해설 공개 상태가 올바르지 않습니다.');checked[id]=value;}\n        for(const [id,value] of Object.entries(s.self||{})){backupAssert(s.ids.includes(id)&&Number.isInteger(value)&&value>=0&&value<=2,'서술형 평가가 올바르지 않습니다.');self[id]=value;}\n        session={ids:s.ids,index:s.index,mode:s.mode,answers,checked,self,submitted:!!s.submitted,startedAt:s.startedAt,endAt:s.endAt,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined,auto:!!s.auto};\n    }return {history,stars:[...new Set(v.stars)],session};\n}\nfunction validateBundle(value){\n    backupAssert(plainObject(value)&&value.format==='computer-study-backup'&&value.version===1&&value.catalog===STUDY_FINGERPRINT&&plainObject(value.records),'이 사이트의 현재 문제은행으로 만든 전체 백업 파일을 선택하세요.');\n    const out={};for(const [key,v] of Object.entries(value.records)){\n        backupAssert(STUDY_KEYS.includes(key),'지원하지 않는 저장 항목입니다.');out[key]=key==='computer-mock-five-v1'?validateMock(v):validatePractice(v);\n    }backupAssert(Object.keys(out).length>0,'백업에 학습 기록이 없습니다.');return out;\n}\nfunction mergeMock(a,b){\n    const records=new Map((a?.history||[]).map(h=>[h.runId,h]));for(const h of b.history)if(!records.has(h.runId))records.set(h.runId,h);\n    const history=[...records.values()].sort((x,y)=>x.at-y.at||x.runId.localeCompare(y.runId)),counts={};history.forEach(h=>h.attempt=counts[h.round]=(counts[h.round]||0)+1);\n    const sessions={...(a?.sessions||{})};for(const [id,s] of Object.entries(b.sessions)){const old=sessions[id];if(!old||Math.max(s.finishedAt||0,s.startedAt)>Math.max(old.finishedAt||0,old.startedAt))sessions[id]=s;}\n    return {version:1,sessions,history,reviewPractice:a?.reviewPractice||b.reviewPractice};\n}\nfunction mergePractice(a,b){const history={...(a?.history||{})};for(const [id,h] of Object.entries(b.history))if(!history[id]||h.at>history[id].at)history[id]=h;const sa=a?.session,sb=b.session;return {history,stars:[...new Set([...(a?.stars||[]),...b.stars])],session:sa&&(!sb||sa.startedAt>=sb.startedAt)?sa:sb};}\nfunction importStudyBackup(bundle){\n    const incoming=validateBundle(bundle),before={},writes={};\n    for(const key of Object.keys(incoming)){\n        before[key]=localStorage.getItem(key);let old=null;\n        if(before[key])old=key==='computer-mock-five-v1'?validateMock(JSON.parse(before[key])):validatePractice(JSON.parse(before[key]));\n        writes[key]=JSON.stringify(key==='computer-mock-five-v1'?mergeMock(old,incoming[key]):mergePractice(old,incoming[key]));\n    }\n    // Keep pre-import records so a bad merge can be undone from the same page.\n    localStorage.setItem('study-before-import-v1',JSON.stringify(before));\n    try{for(const [key,value] of Object.entries(writes))localStorage.setItem(key,value);}\n    catch(error){for(const [key,value] of Object.entries(before)){if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value);}throw error;}\n    if(typeof onStudyRecordsRestored==='function')onStudyRecordsRestored();return Object.keys(writes).length;\n}\nfunction exportStudyBackup(){\n    const records={};for(const key of STUDY_KEYS){const raw=localStorage.getItem(key);if(raw)records[key]=JSON.parse(raw);}\n    const bundle={format:'computer-study-backup',version:1,catalog:STUDY_FINGERPRINT,createdAt:new Date().toISOString(),records};\n    validateBundle(bundle);const url=URL.createObjectURL(new Blob([JSON.stringify(bundle,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='전산학습_전체백업_'+new Date().toLocaleDateString('sv-SE',{timeZone:'Asia/Seoul'})+'.json';a.click();URL.revokeObjectURL(url);\n}\nfunction undoStudyImport(){const raw=localStorage.getItem('study-before-import-v1');backupAssert(raw,'되돌릴 가져오기 기록이 없습니다.');const before=JSON.parse(raw);for(const key of STUDY_KEYS){if(!Object.prototype.hasOwnProperty.call(before,key))continue;const value=before[key];if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value);}localStorage.removeItem('study-before-import-v1');if(typeof onStudyRecordsRestored==='function')onStudyRecordsRestored();}\nconst backupPanel=document.createElement('section');backupPanel.className='panel';backupPanel.innerHTML='<h2>학습 기록 백업·복원</h2><div class=\"row\"><button id=\"downloadStudyBackup\">학습 기록 백업</button><button id=\"chooseStudyBackup\">백업 가져오기</button><button id=\"undoStudyImport\">가져오기 되돌리기</button><input id=\"studyBackupFile\" type=\"file\" accept=\"application/json,.json\" hidden></div><p class=\"small muted\">이 페이지에서 접근 가능한 기록을 백업합니다. 로컬 파일로 이용할 때는 연습·모의고사 페이지에서 각각 백업해 두세요. 가져오기는 기존 기록과 합치며 같은 응시는 중복 추가하지 않습니다.</p><p id=\"backupStatus\" role=\"status\" aria-live=\"polite\"></p>';\ndocument.querySelector('main').appendChild(backupPanel);\ndocument.getElementById('downloadStudyBackup').onclick=()=>{try{exportStudyBackup();document.getElementById('backupStatus').textContent='백업 파일을 내려받았습니다.';}catch(e){document.getElementById('backupStatus').textContent=e.message;}};\ndocument.getElementById('chooseStudyBackup').onclick=()=>document.getElementById('studyBackupFile').click();\ndocument.getElementById('studyBackupFile').onchange=async event=>{const file=event.target.files[0];if(!file)return;try{backupAssert(file.size<=15*1024*1024,'15 MB 이하의 백업 파일을 선택하세요.');const count=importStudyBackup(JSON.parse(await file.text()));document.getElementById('backupStatus').textContent=count+'개 기록 영역을 복원했습니다. 화면에도 반영했습니다.';}catch(e){document.getElementById('backupStatus').textContent='가져오지 않았습니다: '+e.message;}event.target.value='';};\ndocument.getElementById('undoStudyImport').onclick=()=>{try{undoStudyImport();document.getElementById('backupStatus').textContent='가져오기 전 기록으로 돌아갔습니다.';}catch(e){document.getElementById('backupStatus').textContent=e.message;}};\n\n</script></html>"