ilable();refreshMockBadges();}\nconst STUDY_CATALOG=__PRIVATE_CATALOG__;const STUDY_FINGERPRINT=__PRIVATE_FINGERPRINT__;const STUDY_COMPATIBLE_FINGERPRINTS=__PRIVATE_COMPATIBLE_FINGERPRINTS__;// Standalone pages have browser-scoped storage. Backups contain only records accessible from this page.\nconst STUDY_KEYS=['cafe-practice-v2','computer-mock-five-v1'];\nfunction backupAssert(ok,message){if(!ok)throw new Error(message);}\nfunction plainObject(v){return !!v&&typeof v==='object'&&!Array.isArray(v)&&Object.getPrototypeOf(v)===Object.prototype;}\nfunction safeAnswers(value,round=null,practice=false){\n    backupAssert(plainObject(value),'답안 형식이 올바르지 않습니다.');const out={};\n    for(const [id,a] of Object.entries(value)){\n        const q=STUDY_CATALOG[id];backupAssert(q&&(round===null||q.round===round),'알 수 없는 문항이 있습니다: '+id);\n        backupAssert((practice&&q.written&&typeof a==='string'&&a.length<=30000)||(!q.written&&Number.isInteger(a)&&a>=0&&a<q.count),'유효하지 않은 답안: '+id);\n        out[id]=a;\n    }return out;\n}\nfunction safeTime(v){return Number.isFinite(v)&&v>=0&&v<1e14;}\nfunction validateMock(value){\n    backupAssert(plainObject(value)&&value.version===1&&plainObject(value.sessions)&&Array.isArray(value.history),'모의고사 기록 형식을 확인하세요.');\n    backupAssert(value.history.length<=20000,'응시 기록이 너무 큽니다.');\n    const history=value.history.map(h=>{\n        backupAssert(plainObject(h)&&Number.isInteger(h.round)&&h.round>=1&&h.round<=5&&typeof h.runId==='string'&&h.runId.length<=160&&safeTime(h.at),'응시 기록의 회차·날짜가 올바르지 않습니다.');\n        const answers=safeAnswers(h.answers,h.round),qs=Object.entries(STUDY_CATALOG).filter(([id,q])=>q.round===h.round),correct=qs.filter(([id,q])=>answers[id]===q.answer).length;\n        backupAssert(h.total===qs.length&&h.correct===correct&&h.score===Math.round(100*correct/qs.length),'문제은행과 점수 기록이 일치하지 않습니다.');\n        return {runId:h.runId,round:h.round,answers,correct,total:qs.length,score:h.score,at:h.at,attempt:1};\n    });\n    backupAssert(new Set(history.map(h=>h.runId)).size===history.length,'중복 응시 ID가 있습니다.');\n    const sessions={};\n    for(const [id,s] of Object.entries(value.sessions)){\n        const round=Number(id);backupAssert(Number.isInteger(round)&&round>=1&&round<=5&&s.round===round&&plainObject(s),'저장된 시험 회차가 올바르지 않습니다.');\n        backupAssert(typeof s.runId==='string'&&s.runId.length<=160&&safeTime(s.startedAt)&&safeTime(s.endAt)&&Number.isInteger(s.index)&&s.index>=0&&s.index<20&&typeof s.submitted==='boolean','저장된 시험 상태가 올바르지 않습니다.');\n        if(s.submitted){const result=history.find(h=>h.runId===s.runId&&h.round===round);backupAssert(result,'제출 답안에 대응하는 점수 기록이 없습니다.');backupAssert(JSON.stringify(Object.entries(s.answers).sort())===JSON.stringify(Object.entries(result.answers).sort()),'제출 답안과 응시 기록이 일치하지 않습니다.');}\n        sessions[id]={round,runId:s.runId,index:s.index,answers:safeAnswers(s.answers,round),startedAt:s.startedAt,endAt:s.endAt,submitted:s.submitted,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined,auto:!!s.auto,reviewWrong:!!s.reviewWrong};\n    }\n    let reviewPractice;\n    if(value.reviewPractice){\n        const s=value.reviewPractice;backupAssert(plainObject(s)&&s.retry===true&&Array.isArray(s.ids)&&s.ids.length>0&&s.ids.length<=20&&new Set(s.ids).size===s.ids.length,'오답 복습 상태가 올바르지 않습니다.');\n        backupAssert(s.ids.every(id=>STUDY_CATALOG[id]?.round===s.round)&&Number.isInteger(s.index)&&s.index>=0&&s.index<s.ids.length&&history.some(h=>h.runId===s.sourceRunId),'오답 복습 문항·원본 응시를 확인하세요.');\n        const answers=safeAnswers(s.answers,s.round);backupAssert(Object.keys(answers).every(id=>s.ids.includes(id)),'복습 범위 밖 답안이 있습니다.');\n        reviewPractice={round:s.round,runId:String(s.runId).slice(0,160),sourceRunId:s.sourceRunId,ids:s.ids,index:s.index,answers,submitted:!!s.submitted,retry:true,endAt:safeTime(s.endAt)?s.endAt:Date.now()+315360000000,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined};\n    }\n    return {version:1,sessions,history,reviewPractice};\n}\nfunction validatePractice(v){\n    backupAssert(plainObject(v)&&plainObject(v.history)&&Array.isArray(v.stars),'연습문제 기록 형식을 확인하세요.');\n    const history={};for(const [id,h] of Object.entries(v.history)){\n        const q=STUDY_CATALOG[id];backupAssert(q&&!q.round&&!q.written&&plainObject(h)&&typeof h.correct==='boolean'&&safeTime(h.at),'연습 채점 기록이 올바르지 않습니다.');\n        backupAssert(h.answer===null||(Number.isInteger(h.answer)&&h.answer>=0&&h.answer<q.count),'연습 답안이 올바르지 않습니다.');\n        backupAssert(h.correct===(h.answer===q.answer),'연습 정오 기록이 문제은행과 다릅니다.');history[id]={correct:h.correct,answer:h.answer,at:h.at};\n    }\n    backupAssert(v.stars.every(id=>STUDY_CATALOG[id]&&!STUDY_CATALOG[id].round),'복습 표시 문항이 올바르지 않습니다.');\n    let session=null;\n    if(v.session){\n        const s=v.session;backupAssert(plainObject(s)&&Array.isArray(s.ids)&&s.ids.length>0&&new Set(s.ids).size===s.ids.length&&s.ids.every(id=>STUDY_CATALOG[id]&&!STUDY_CATALOG[id].round),'연습 세션 문항이 올바르지 않습니다.');\n        backupAssert(Number.isInteger(s.index)&&s.index>=0&&s.index<s.ids.length&&['exam','practice'].includes(s.mode)&&safeTime(s.startedAt)&&(s.endAt===null||safeTime(s.endAt)),'연습 세션 상태가 올바르지 않습니다.');\n        const answers=safeAnswers(s.answers,null,true);backupAssert(Object.keys(answers).every(id=>s.ids.includes(id)),'세션 범위 밖 답안이 있습니다.');\n        const checked={},self={};for(const [id,value] of Object.entries(s.checked||{})){backupAssert(s.ids.includes(id)&&typeof value==='boolean','해설 공개 상태가 올바르지 않습니다.');checked[id]=value;}\n        for(const [id,value] of Object.entries(s.self||{})){backupAssert(s.ids.includes(id)&&Number.isInteger(value)&&value>=0&&value<=2,'서술형 평가가 올바르지 않습니다.');self[id]=value;}\n        session={ids:s.ids,index:s.index,mode:s.mode,answers,checked,self,submitted:!!s.submitted,startedAt:s.startedAt,endAt:s.endAt,finishedAt:safeTime(s.finishedAt)?s.finishedAt:undefined,auto:!!s.auto};\n    }return {history,stars:[...new Set(v.stars)],session};\n}\nfunction validateBundle(value){\n    backupAssert(plainObject(value)&&value.format==='computer-study-backup'&&value.version===1&&STUDY_COMPATIBLE_FINGERPRINTS.includes(value.catalog)&&plainObject(value.records),'이 사이트의 현재 문제은행으로 만든 전체 백업 파일을 선택하세요.');\n    const out={};for(const [key,v] of Object.entries(value.records)){\n        backupAssert(STUDY_KEYS.includes(key),'지원하지 않는 저장 항목입니다.');out[key]=key==='computer-mock-five-v1'?validateMock(v):validatePractice(v);\n    }backupAssert(Object.keys(out).length>0,'백업에 학습 기록이 없습니다.');return out;\n}\nfunction mergeMock(a,b){\n    const records=new Map((a?.history||[]).map(h=>[h.runId,h]));for(const h of b.history)if(!records.has(h.runId))records.set(h.runId,h);\n    const history=[...records.values()].sort((x,y)=>x.at-y.at||x.runId.localeCompare(y.runId)),counts={};history.forEach(h=>h.attempt=counts[h.round]=(counts[h.round]||0)+1);\n    const sessions={...(a?.sessions||{})};for(const [id,s] of Object.entries(b.sessions)){const old=sessions[id];if(!old||Math.max(s.finishedAt||0,s.startedAt)>Math.max(old.finishedAt||0,old.startedAt))sessions[id]=s;}\n    return {version:1,sessions,history,reviewPractice:a?.reviewPractice||b.reviewPractice};\n}\nfunction mergePractice(a,b){const history={...(a?.history||{})};for(const [id,h] of Object.entries(b.history))if(!history[id]||h.at>history[id].at)history[id]=h;const sa=a?.session,sb=b.session;return {history,stars:[...new Set([...(a?.stars||[]),...b.stars])],session:sa&&(!sb||sa.startedAt>=sb.startedAt)?sa:sb};}\nfunction importStudyBackup(bundle){\n    const incoming=validateBundle(bundle),before={},writes={};\n    for(const key of Object.keys(incoming)){\n        before[key]=localStorage.getItem(key);let old=null;\n        if(before[key])old=key==='computer-mock-five-v1'?validateMock(JSON.parse(before[key])):validatePractice(JSON.parse(before[key]));\n        writes[key]=JSON.stringify(key==='computer-mock-five-v1'?mergeMock(old,incoming[key]):mergePractice(old,incoming[key]));\n    }\n    // Keep pre-import records so a bad merge can be undone from the same page.\n    localStorage.setItem('study-before-import-v1',JSON.stringify(before));\n    try{for(const [key,value] of Object.entries(writes))localStorage.setItem(key,value);}\n    catch(error){for(const [key,value] of Object.entries(before)){if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value);}throw error;}\n    if(typeof onStudyRecordsRestored==='function')onStudyRecordsRestored();return Object.keys(writes).length;\n}\nfunction exportStudyBackup(){\n    const records={};for(const key of STUDY_KEYS){const raw=localStorage.getItem(key);if(raw)records[key]=JSON.parse(raw);}\n    const bundle={format:'computer-study-backup',version:1,catalog:STUDY_FINGERPRINT,createdAt:new Date().toISOString(),records};\n    validateBundle(bundle);const url=URL.createObjectURL(new Blob([JSON.stringify(bundle,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='전산학습_전체백업_'+new Date().toLocaleDateString('sv-SE',{timeZone:'Asia/Seoul'})+'.json';a.click();URL.revokeObjectURL(url);\n}\nfunction undoStudyImport(){const raw=localStorage.getItem('study-before-import-v1');backupAssert(raw,'되돌릴 가져오기 기록이 없습니다.');const before=JSON.parse(raw);for(const key of STUDY_KEYS){if(!Object.prototype.hasOwnProperty.call(before,key))continue;const value=before[key];if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value);}localStorage.removeItem('study-before-import-v1');if(typeof onStudyRecordsRestored==='function')onStudyRecordsRestored();}\nconst backupPanel=document.createElement('section');backupPanel.className='panel';backupPanel.innerHTML='<h2>학습 기록 백업·복원</h2><div class=\"row\"><button id=\"downloadStudyBackup\">학습 기록 백업</button><button id=\"chooseStudyBackup\">백업 가져오기</button><button id=\"undoStudyImport\">가져오기 되돌리기</button><input id=\"studyBackupFile\" type=\"file\" accept=\"application/json,.json\" hidden></div><p class=\"small muted\">이 페이지에서 접근 가능한 기록을 백업합니다. 로컬 파일로 이용할 때는 연습·모의고사 페이지에서 각각 백업해 두세요. 가져오기는 기존 기록과 합치며 같은 응시는 중복 추가하지 않습니다.</p><p id=\"backupStatus\" role=\"status\" aria-live=\"polite\"></p>';\ndocument.querySelector('main').appendChild(backupPanel);\ndocument.getElementById('downloadStudyBackup').onclick=()=>{try{exportStudyBackup();document.getElementById('backupStatus').textContent='백업 파일을 내려받았습니다.';}catch(e){document.getElementById('backupStatus').textContent=e.message;}};\ndocument.getElementById('chooseStudyBackup').onclick=()=>document.getElementById('studyBackupFile').click();\ndocument.getElementById('studyBackupFile').onchange=async event=>{const file=event.target.files[0];if(!file)return;try{backupAssert(file.size<=15*1024*1024,'15 MB 이하의 백업 파일을 선택하세요.');const count=importStudyBackup(JSON.parse(await file.text()));document.getElementById('backupStatus').textContent=count+'개 기록 영역을 복원했습니다. 화면에도 반영했습니다.';}catch(e){document.getElementById('backupStatus').textContent='가져오지 않았습니다: '+e.message;}event.target.value='';};\ndocument.getElementById('undoStudyImport').onclick=()=>{try{undoStudyImport();document.getElementById('backupStatus').textContent='가져오기 전 기록으로 돌아갔습니다.';}catch(e){document.getElementById('backupStatus').textContent=e.message;}};\n\n</script></html>"