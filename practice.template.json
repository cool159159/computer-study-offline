"<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>전산·ICT 필기 연습시험</title>\n<style>\n:root{--bg:#f3f6fa;--card:#fff;--ink:#17283e;--muted:#607287;--line:#d7e1ec;--blue:#155fa8;--soft:#eaf3fd;--good:#176b42;--bad:#b33232}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 'Malgun Gothic',Arial,sans-serif}main{max-width:1260px;margin:auto;padding:28px 24px 70px}h1{font-size:31px;letter-spacing:-1px;line-height:1.4;margin:6px 0 10px}h2{font-size:23px;margin:0 0 15px}h3{font-size:18px;margin:10px 0}a{color:var(--blue)}button,input,select,textarea{font:inherit}button{background:white;border:1px solid #b8cada;border-radius:7px;padding:10px 15px;color:var(--ink);cursor:pointer}button:hover{background:var(--soft)}button:disabled{opacity:.5;cursor:default}.primary{background:var(--blue);color:white;border-color:var(--blue)}.primary:hover{background:#104f8c}.muted{color:var(--muted)}.eyebrow{color:var(--blue);font-size:12px;letter-spacing:2px;font-weight:bold}.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:24px;margin:20px 0}.note{padding:15px 18px;background:#edf4fc;border-left:4px solid var(--blue);margin:18px 0}.warning{background:#fff7e8;border-color:#dcaa54}.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}.pill{display:inline-block;border-radius:18px;background:var(--soft);padding:3px 10px;font-size:12px;margin:3px 5px 3px 0}.controls{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.controls label{font-size:12px;font-weight:bold}.controls input,.controls select{display:block;margin-top:5px;width:100%;border:1px solid #b9c9db;border-radius:6px;background:#fff;padding:10px;color:var(--ink)}.controls .wide{grid-column:span 2}.small{font-size:12px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stat b{display:block;font-size:28px}.stat span{font-size:13px;color:var(--muted)}.layout{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:22px}.layout .panel{margin-top:12px}.stem{white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:1.9;background:#f6f8fb;padding:20px;border-radius:8px;font-family:'Malgun Gothic',Consolas,monospace}.choices{display:grid;gap:11px;margin:20px 0}.choice{display:flex;align-items:flex-start;gap:10px;border:1px solid #cbd8e6;border-radius:8px;padding:14px;cursor:pointer}.choice:has(input:checked){border-color:var(--blue);background:var(--soft)}.choice.correct{border:2px solid var(--good);background:#edf8f1}.choice.wrong{border:2px solid var(--bad);background:#fff1f1}.choice input{margin-top:6px;accent-color:var(--blue)}textarea{width:100%;min-height:170px;border:1px solid #b9cadb;border-radius:8px;padding:15px;resize:vertical;line-height:1.8}#explanation{border-top:1px solid var(--line);padding-top:16px;margin-top:20px}.answer{font-size:20px;font-weight:bold}.correctText{color:var(--good)}.wrongText{color:var(--bad)}.explainText{white-space:pre-wrap;line-height:1.9}.source{background:#f5f8fc;padding:15px;border-radius:8px;margin-top:18px;font-size:13px}.source a{display:block;margin:7px 0}.navgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.navgrid button{padding:8px 0;font-size:12px}.navgrid .current{outline:2px solid var(--blue)}.navgrid .answered{background:#dbeafb}.navgrid .right{background:#e0f2e5;color:var(--good)}.navgrid .incorrect{background:#ffe7e7;color:var(--bad)}.progress{height:7px;background:#dce5ef;border-radius:4px;margin:14px 0;overflow:hidden}.progress span{display:block;height:100%;background:var(--blue)}#timer{font-size:22px;font-variant-numeric:tabular-nums;font-weight:bold}.score{font-size:42px;font-weight:bold;line-height:1.4}.reviewtable{width:100%;border-collapse:collapse;font-size:13px}.reviewtable td,.reviewtable th{padding:10px;border-bottom:1px solid var(--line);text-align:left}.reviewtable th{background:#f0f4fa}.checklist label{display:block;margin:8px 0}.star[aria-pressed=true]{background:#fff1cd;border-color:#d0a342}.hidden,[hidden]{display:none!important}.statusline{min-height:26px}.spacer{margin-top:16px}footer{font-size:12px;color:var(--muted);margin-top:30px}details{margin:12px 0}summary{cursor:pointer}#selfgrade button[aria-pressed=true]{background:var(--blue);color:white}.finishbar{border-top:1px solid var(--line);margin-top:18px;padding-top:16px}.error{color:var(--bad)}@media(max-width:850px){.layout{grid-template-columns:1fr}.controls{grid-template-columns:1fr 1fr}.navgrid{grid-template-columns:repeat(10,1fr)}.layout aside{order:2}h1{font-size:26px}}@media(max-width:480px){main{padding:18px 12px}.panel{padding:17px}.controls{grid-template-columns:1fr}.controls .wide{grid-column:auto}.stats{grid-template-columns:1fr 1fr 1fr}.stat b{font-size:23px}.navgrid{grid-template-columns:repeat(8,1fr)}.stem{padding:14px;font-size:15px}.row button{flex-grow:1}}@media print{button,.controls,aside,#setup{display:none}.layout{display:block}.panel{border:0}.stem{background:white}}\n\n.stem{font-family:'Malgun Gothic',Arial,sans-serif}\n.code-editor{border:1px solid #344359;border-radius:10px;overflow:hidden;margin:18px 0;background:#172131;color:#e1e9f3}\n.code-toolbar{display:flex;justify-content:space-between;align-items:center;background:#233044;color:#c5d5e8;padding:9px 15px;font:12px/1.5 Consolas,monospace;gap:12px}\n.code-view{margin:0;padding:12px 0;overflow-x:auto;tab-size:4;font:15px/1.85 'Cascadia Code',Consolas,'Courier New',monospace;white-space:pre;counter-reset:code-line}\n.code-line{display:block;min-width:max-content;padding-right:24px}.code-line:before{counter-increment:code-line;content:counter(code-line);display:inline-block;width:44px;margin-right:18px;padding-right:12px;text-align:right;color:#8c9eb6;border-right:1px solid #35445a;user-select:none}\n.tok-keyword{color:#c7a6ff}.tok-string{color:#b5df9f}.tok-number{color:#f4c788}.tok-comment{color:#8ea3b8}.tok-call{color:#91caff}\n@media(max-width:480px){.code-view{font-size:14px}.code-line:before{width:32px;margin-right:12px;padding-right:8px}}\n\n.math-box{padding:16px 20px;margin:16px 0;background:#edf3fb;border-radius:8px;overflow-x:auto;color:#17283e}\n.math-box math{font-family:'Cambria Math','STIX Two Math',serif;font-size:24px;line-height:1.8;margin:4px 0;min-width:max-content}\n.math-box msup>:last-child,.math-box msub>:last-child{math-depth:0;font-size:19px}\n.math-power,.math-sub{font-family:Arial,'Malgun Gothic',sans-serif;font-size:.9em;font-weight:600;line-height:0;position:relative;vertical-align:baseline}\n.math-power{top:-.42em}.math-sub{bottom:-.2em}\n@media(max-width:480px){.math-box{padding:12px}.math-box math{font-size:22px}.math-box msup>:last-child,.math-box msub>:last-child{font-size:18px}}\n\n.question-figure{margin:18px 0;padding:18px;border:1px solid #d5dfeb;background:#fff;border-radius:10px}\n.question-svg{display:block;width:100%;max-width:580px;height:auto;margin:auto;color:#243c59}\n.question-svg .edge{stroke:#59728d;stroke-width:2.2;fill:none}.question-svg .node,.question-svg .gate-shape{fill:#eef5fd;stroke:#2c608f;stroke-width:2.2}.question-svg .nofill{fill:none}\n.question-svg text{font:17px 'Malgun Gothic',Consolas,sans-serif;fill:#172f4c}.question-svg .weight{font-weight:bold}.question-svg .weight-bg{fill:#fff}\n.figure-tables{display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;justify-content:center}.data-figure{border-collapse:collapse;margin:6px auto;min-width:190px;font:15px/1.6 Consolas,'Malgun Gothic',sans-serif}.data-figure caption{font-family:'Malgun Gothic',sans-serif;font-weight:bold;margin-bottom:8px;color:#294f77}.data-figure td,.data-figure th{border:1px solid #b6c8dc;text-align:center;padding:9px 15px}.data-figure th{background:#eaf1f9}\n.option-body{display:block;min-width:0;flex:1}.option-graphic{display:block;margin:10px auto 0;max-width:330px}.option-graphic .question-svg{max-height:180px}.option-graphic .matrix-wrap{max-width:150px}.option-graphic .matrix-cell{padding:4px}\n.matrix-wrap{max-width:300px;margin:8px auto;border-left:3px solid #375c83;border-right:3px solid #375c83;padding:9px 13px}.matrix-grid{display:grid;gap:4px}.matrix-cell{text-align:center;font:18px/1.7 Consolas,monospace;padding:8px;background:#f0f4fa}.matrix-cell.block-border{background:#e0ebf8}\n.memory-blocks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.memory-blocks>div{border:1px solid #9cb4ce;padding:14px 6px;text-align:center;background:#f1f6fd}.memory-blocks span{display:block;font-size:12px}.memory-blocks b{display:block;font-size:18px}.sequence{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}.sequence span{border:1px solid #a7bdd6;background:#edf4fd;border-radius:6px;padding:7px 15px;font:18px Consolas,monospace}\n@media(max-width:480px){.question-figure{padding:10px}.question-svg text{font-size:20px}.memory-blocks{grid-template-columns:repeat(2,1fr)}.data-figure{min-width:155px}.data-figure td,.data-figure th{padding:6px 8px}.option-graphic .question-svg text{font-size:19px}}\n\n.frequency-panel{background:#edf4fc;border-left:4px solid #3676b4;border-radius:6px;padding:12px 16px;margin:0 0 18px;font-size:14px}\n.frequency-panel strong{font-size:16px}.frequency-panel p{margin:4px 0}.frequency-panel details{margin:7px 0 0}.frequency-panel li{margin:8px 0}.frequency-panel blockquote{margin:4px 0;padding-left:10px;border-left:2px solid #bfd0e4;color:#52677e;white-space:pre-wrap}\n\n.rel-symbol{font-family:'Cambria Math','Segoe UI Symbol','DejaVu Sans',serif;font-size:1.45em;font-weight:normal;font-style:normal;line-height:1;display:inline-block;vertical-align:-.06em;padding:0 .07em}\n\nbody{padding-bottom:env(safe-area-inset-bottom)}input,select,textarea{font-size:16px}svg{max-width:100%;height:auto}table{display:block;max-width:100%;overflow-x:auto}pre{max-width:100%;overflow-x:auto}@media(max-width:600px){main{padding:16px 12px}.panel{padding:16px}.choice{min-height:48px}.layout{display:block}h1{font-size:25px}.stem{font-size:17px}}\n</style>\n<main><p><a href=\"index.html\">← 내 학습자료 관리</a></p><header><div class=\"eyebrow\">PRACTICE LAB / CAFE FIELD NOTES</div><h1>전산·ICT·개발 필기 연습시험</h1><p class=\"muted\">후기의 세부 문항 단서를 문제로 재구성하고, 주제형 단서는 개념·응용 문제로 확장했습니다.</p><div class=\"row\"><a href=\"필기후기_분석보고서.html\">← 빈도 분석 보고서</a><a href=\"#\" onclick=\"event.preventDefault();window.exportPrivateBank()\">문제은행 데이터</a><a href=\"학습자료_색인.html\">교재 주제별 색인</a><a href=\"전산_모의고사.html\"><b>모의고사 5회 →</b></a></div></header>\n<div class=\"note warning\"><b>공식 기출 원문 복원이 아닌 학습용 재구성입니다.</b> 누락된 조건·보기·수치는 새로 만들었습니다. 각 문제의 「후기 단서 재구성 / 주제 기반 창작」 표시와 출처를 확인하세요. 카페 이미지 속 복원 내용은 반영하지 않았습니다. 사용자 제공 자료는 별도로 추가했으며, 연도 미상인 복원은 기존 2025~2026 카페 빈도 집계에 합산하지 않았습니다.</div>\n<div id=\"mockBadges\" class=\"row\" aria-label=\"모의고사 점수 배지\"></div><section id=\"setup\" class=\"panel\"><div class=\"row between\"><h2>연습할 문제 선택</h2><span id=\"stored\" class=\"small muted\"></span></div><div class=\"stats\"><div class=\"stat\"><b id=\"totalQuestions\"></b><span>전체 문제</span></div><div class=\"stat\"><b id=\"typeCounts\"></b><span>객관식 + 개념 서술형</span></div><div class=\"stat\"><b id=\"originCounts\"></b><span>후기 재구성 + 주제 창작</span></div></div><p class=\"small muted\">모든 문제에 정답·해설·핵심 개념·원문 링크가 있습니다. 서술형은 자동 점수에 섞지 않고 체크리스트로 자기 평가합니다.</p>\n<div class=\"controls\"><label>추가 자료<select id=\"batch\"><option value=\"\">전체 자료</option></select></label><label>주제<select id=\"topic\"><option value=\"\">전체 주제</option></select></label><label>문제 유형<select id=\"type\"><option value=\"\">객관식 + 서술형</option><option>객관식</option><option>개념 서술형</option></select></label><label>문제 출처 유형<select id=\"origin\"><option value=\"\">전체</option><option>후기 단서 재구성</option><option>주제 기반 창작</option></select></label><label>연습 방식<select id=\"mode\"><option value=\"practice\">연습 — 문제마다 해설 확인</option><option value=\"exam\">시험 — 제출 후 해설 공개</option></select></label>\n<label>자료 구분<select id=\"material\"><option value=\"\">모든 자료</option><option>2025~2026 카페 후기</option><option>사용자 제공 복원</option></select></label><label>기관<select id=\"institution\"><option value=\"\">모든 출처 기관</option></select></label><label>문항 수<select id=\"count\"><option value=\"20\">20문항</option><option value=\"10\">10문항</option><option value=\"40\">40문항</option><option value=\"all\">조건에 맞는 전체</option></select></label><label>시험 제한시간(분)<input id=\"minutes\" type=\"number\" min=\"1\" max=\"180\" value=\"30\"></label><label>복습 범위<select id=\"scope\"><option value=\"all\">전체</option><option value=\"wrong\">이전에 틀린 객관식</option><option value=\"star\">표시한 문제</option><option value=\"unseen\">아직 채점하지 않은 문제</option></select></label>\n<label class=\"wide\">제목·문제·단서 검색<input id=\"search\" placeholder=\"예: 얕은 복사, HRN, JOIN, 서브넷\"></label></div>\n<div class=\"row between spacer\"><div id=\"available\" class=\"statusline\" aria-live=\"polite\"></div><div class=\"row\"><button id=\"clearSource\" hidden>출처 글 필터 해제</button><button id=\"resume\" hidden>저장된 풀이 이어가기</button><button id=\"start\" class=\"primary\">선택한 조건으로 시작</button></div></div><p id=\"setupError\" role=\"alert\" class=\"error\"></p><details><summary>해설 검증에 참고한 기술 문서</summary><div id=\"refs\"></div></details></section>\n<section id=\"result\" class=\"panel\" hidden aria-live=\"polite\"></section>\n<section id=\"workspace\" hidden><div class=\"row between\"><div><span id=\"sessionLabel\" class=\"pill\"></span><b id=\"position\"></b></div><div class=\"row\"><span id=\"timer\"></span><button id=\"backSetup\">문제 선택으로</button></div></div><div class=\"progress\" role=\"progressbar\" aria-label=\"응답 진행률\" aria-valuemin=\"0\" aria-valuemax=\"100\"><span id=\"progress\"></span></div>\n<div class=\"layout\"><article class=\"panel\"><div class=\"row between\"><div id=\"qtags\"></div><button id=\"star\" class=\"star\" aria-pressed=\"false\">☆ 복습 표시</button></div><h2 id=\"qtitle\"></h2><section id=\"questionFrequency\" class=\"frequency-panel\" aria-label=\"관련 개념의 회차별 언급\"></section><div id=\"stem\" class=\"stem\"></div><figure id=\"questionFigure\" class=\"question-figure\" hidden></figure><div id=\"promptMath\" class=\"math-box\" hidden></div><section id=\"codePanel\" class=\"code-editor\" hidden aria-label=\"문제 코드\"><div class=\"code-toolbar\"><span id=\"codeLanguage\"></span><span>읽기 전용</span></div><pre id=\"codeView\" class=\"code-view\"><code id=\"codeContent\"></code></pre></section><div id=\"choices\" class=\"choices\"></div><label id=\"writtenBox\" hidden>내 답안<textarea id=\"written\" placeholder=\"정의·이유·예시를 포함해 설명해 보세요.\"></textarea></label><div id=\"questionStatus\" class=\"small muted\" aria-live=\"polite\"></div><div class=\"row between spacer\"><button id=\"prev\">이전 문제</button><button id=\"check\" class=\"primary\">정답·해설 확인</button><button id=\"next\">다음 문제</button></div>\n<section id=\"explanation\" hidden><div id=\"answerLabel\" class=\"answer\"></div><h3>풀이·해설</h3><div id=\"explainText\" class=\"explainText\"></div><div id=\"solutionMath\" class=\"math-box\" hidden></div><h3 id=\"conceptHeading\">핵심 개념</h3><p id=\"conceptText\" class=\"explainText\"></p><div id=\"rubricBox\" hidden><h3>자기 점검</h3><div id=\"rubric\" class=\"checklist\"></div><div id=\"selfgrade\" class=\"row\"><button data-score=\"0\">0 — 다시 공부</button><button data-score=\"1\">1 — 일부 이해</button><button data-score=\"2\">2 — 설명 가능</button></div></div><div id=\"sources\" class=\"source\"></div></section>\n<div class=\"finishbar row between\"><span id=\"answeredCount\" class=\"small muted\"></span><button id=\"finish\">답안 제출·채점</button></div></article><aside class=\"panel\"><h3>문제 이동</h3><p class=\"small muted\">파랑: 응답 · 초록: 정답 · 빨강: 오답<br>서술형은 객관식 점수와 별도 평가</p><div id=\"nav\" class=\"navgrid\"></div><p id=\"saveStatus\" class=\"small muted\">풀이 저장 준비 중</p></aside></div></section>\n<footer>해설은 학습 목적의 새 설명이며 후기 작성자의 답을 그대로 정답으로 채택하지 않았습니다. 기관 필터는 문항 제작에 직접 사용한 출처 기관 기준으로, 해당 기관의 실제 출제 빈도나 전체 시험 범위를 나타내지 않습니다. 현재 브라우저에 풀이와 오답·복습 표시를 저장합니다.</footer></main>\n<script id=\"quizdata\" type=\"application/json\">__PRIVATE_BANK__</script><script>\nconst BANK=JSON.parse(document.getElementById('quizdata').textContent),Q=new Map(BANK.questions.map(q=>[q.id,q])),$=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst KEY='cafe-practice-v2'+(new URLSearchParams(location.search).has('qa')?'-qa':'');let storageOK=true,saved={history:{},stars:[],session:null};try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&typeof v.history==='object'&&Array.isArray(v.stars))saved=v;}catch(e){storageOK=false;}let session=saved.session,stars=new Set(saved.stars),sourceId=new URLSearchParams(location.search).get('source')||'';\n// 삭제된 NCS 문항의 저장 상태만 정리\n\nfor(const id of Object.keys(saved.history))if(!Q.has(id))delete saved.history[id];\nstars=new Set([...stars].filter(id=>Q.has(id)));\nif(session&&Array.isArray(session.ids)){session.ids=session.ids.filter(id=>Q.has(id));if(!session.ids.length){session=null;}else{session.index=Math.min(session.index||0,session.ids.length-1);for(const field of ['answers','checked','self']){session[field]=session[field]||{};for(const id of Object.keys(session[field]))if(!Q.has(id))delete session[field][id];}}}\n\nfunction persist(){saved.session=session;saved.stars=[...stars];try{localStorage.setItem(KEY,JSON.stringify(saved));$('saveStatus').textContent='이 브라우저에 자동 저장됨';}catch(e){storageOK=false;$('saveStatus').textContent='저장 공간을 사용할 수 없어 이 창에서만 풀이가 유지됩니다.';}}\ndocument.title='전산·ICT 필기 연습시험 — '+BANK.questions.length+'문항';\n$('totalQuestions').textContent=BANK.questions.length;\n$('typeCounts').textContent=BANK.questions.filter(q=>q.type==='객관식').length+' + '+BANK.questions.filter(q=>q.type!=='객관식').length;\n$('originCounts').textContent=BANK.questions.filter(q=>q.origin==='후기 단서 재구성').length+' + '+BANK.questions.filter(q=>q.origin==='주제 기반 창작').length;\n$('batch').innerHTML+=[...new Set(BANK.questions.map(q=>q.update_batch).filter(Boolean))].sort().reverse().map(d=>'<option value=\"'+esc(d)+'\">'+esc(d)+' 추가</option>').join('');\nlet topics=[...new Set(BANK.questions.map(q=>q.topic))],institutions=[...new Set(BANK.questions.flatMap(q=>q.source_details.map(s=>s.institution)))].sort((a,b)=>a.localeCompare(b,'ko'));\n$('topic').innerHTML+=topics.map(t=>`<option>${esc(t)}</option>`).join('');$('institution').innerHTML+=institutions.map(t=>`<option>${esc(t)}</option>`).join('');$('refs').innerHTML=BANK.references.map(r=>`<p><a href=\"${esc(r.url)}\" target=\"_blank\" rel=\"noopener\">${esc(r.title)}</a></p>`).join('');\nfunction proseMath(value){\n    const glyphs={'⁰':'0','¹':'1','²':'2','³':'3','⁴':'4','⁵':'5','⁶':'6','⁷':'7','⁸':'8','⁹':'9','ᵃ':'a','ᵇ':'b','ⁿ':'n','ˣ':'x','⁺':'+','⁻':'−','₀':'0','₁':'1','₂':'2','₃':'3','₄':'4','₅':'5','₆':'6','₇':'7','₈':'8','₉':'9'};\n    return esc(value).replace(/[⁰¹²³⁴⁵⁶⁷⁸⁹ᵃᵇⁿˣ⁺⁻]+|[₀₁₂₃₄₅₆₇₈₉]+/g,run=>{\n        const sub=/^[₀₁₂₃₄₅₆₇₈₉]/.test(run),tag=sub?'sub':'sup';\n        return '<'+tag+' class=\"'+(sub?'math-sub':'math-power')+'\">'+[...run].map(c=>glyphs[c]).join('')+'</'+tag+'>';\n    }).replace(/[σπ⋈∪∩÷×]/g,symbol=>'<span class=\"rel-symbol\">'+symbol+'</span>');\n}\nfunction refreshMockBadges(){\n    try{const m=JSON.parse(localStorage.getItem('computer-mock-five-v1')||'null'),history=m?.history||[];const groups=new Map();history.forEach(h=>{if(!groups.has(h.round))groups.set(h.round,[]);groups.get(h.round).push(h)});$('mockBadges').innerHTML=[...groups].sort((a,b)=>a[0]-b[0]).map(([id,hs])=>'<div><b>모의 '+id+'회차</b> '+hs.map((h,i)=>'<a class=\"pill\" style=\"background:#e5f2e9;color:#165c39\" href=\"전산_모의고사.html\">'+(i+1)+'차 '+h.score+'점</a>').join('')+'</div>').join('');}catch(e){$('mockBadges').innerHTML='';}\n}\nrefreshMockBadges();window.addEventListener('storage',refreshMockBadges);window.addEventListener('focus',refreshMockBadges);\nfunction eligible(){let search=$('search').value.trim().toLowerCase();return BANK.questions.filter(q=>(!$('batch').value||q.update_batch===$('batch').value)&&(!$('topic').value||q.topic===$('topic').value)&&(!$('type').value||q.type===$('type').value)&&(!$('origin').value||q.origin===$('origin').value)&&(!$('material').value||q.material===$('material').value)&&(!$('institution').value||q.source_details.some(s=>s.institution===$('institution').value))&&(!sourceId||q.sources.includes(sourceId))&&(!search||[q.id,q.title,q.stem,q.clue,q.topic,q.update_batch].join(' ').toLowerCase().includes(search))&&($('scope').value!=='wrong'||saved.history[q.id]?.correct===false)&&($('scope').value!=='star'||stars.has(q.id))&&($('scope').value!=='unseen'||!saved.history[q.id]));}\nfunction available(){let qs=eligible();$('available').textContent=`선택 가능한 문제 ${qs.length}개${sourceId?' · 출처 글 '+sourceId:''}`;$('clearSource').hidden=!sourceId;$('resume').hidden=!session||!Array.isArray(session.ids)||session.ids.some(id=>!Q.has(id));$('stored').textContent=`채점한 객관식 ${Object.keys(saved.history).length}개 · 복습 표시 ${stars.size}개`;$('minutes').disabled=$('mode').value!=='exam';}\nfunction shuffled(a){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a;}\nfunction start(){let pool=eligible();if(!pool.length){$('setupError').textContent='조건에 맞는 문제가 없습니다. 주제·유형·복습 범위를 바꿔 주세요.';return;}let mins=Number($('minutes').value);if($('mode').value==='exam'&&(!Number.isFinite(mins)||mins<1||mins>180)){$('setupError').textContent='시험시간을 1~180분으로 입력해 주세요.';return;}$('setupError').textContent='';let n=$('count').value==='all'?pool.length:Math.min(Number($('count').value),pool.length);session={ids:shuffled(pool).slice(0,n).map(q=>q.id),index:0,mode:$('mode').value,answers:{},checked:{},self:{},submitted:false,startedAt:Date.now(),endAt:$('mode').value==='exam'?Date.now()+mins*60000:null};persist();showSession();}\nfunction showSession(){$('setup').hidden=true;$('workspace').hidden=false;if(session.submitted)showResult();else $('result').hidden=true;render();tick();$('workspace').scrollIntoView({behavior:'smooth'});}\nfunction answerPresent(q){let a=session.answers[q.id];return q.type==='객관식'?Number.isInteger(a):typeof a==='string'&&a.trim().length>0;}\nfunction canReveal(q){return session.submitted||(session.mode==='practice'&&session.checked[q.id]);}\nfunction assess(q){if(q.type!=='객관식')return;let a=session.answers[q.id];saved.history[q.id]={correct:a===q.answer,answer:Number.isInteger(a)?a:null,at:Date.now()};}\n\nfunction highlightCode(line){\n    const tokens=/(\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|\\/\\/.*$|#.*$|\\b(?:def|return|import|from|as|class|extends|static|void|new|int|for|if|else|while|public|private|protected|String|Object|StringBuilder|SELECT|FROM|LEFT|JOIN|ON|WHERE|GROUP|BY|ORDER|NULL|True|False|None)\\b|\\b\\d+(?:\\.\\d+)?\\b|\\b[A-Za-z_]\\w*(?=\\s*\\())/g;\n    let out='',last=0;\n    for(const m of line.matchAll(tokens)){\n        out+=esc(line.slice(last,m.index));let t=m[0],kind=/^[\"']/.test(t)?'string':/^(\\/\\/|#)/.test(t)?'comment':/^\\d/.test(t)?'number':/^[A-Za-z_]\\w*$/.test(t)&&/^\\s*\\(/.test(line.slice(m.index+t.length))?'call':'keyword';\n        out+='<span class=\"tok-'+kind+'\">'+esc(t)+'</span>';last=m.index+t.length;\n    }\n    return out+esc(line.slice(last));\n}\nfunction renderCode(q){$('codePanel').hidden=!q.code;if(!q.code){$('codeContent').textContent='';return;}$('codeLanguage').textContent=q.language||'Code';$('codeContent').innerHTML=q.code.split('\\n').map(line=>'<span class=\"code-line\">'+(highlightCode(line)||' ')+'</span>').join('');}\n\nfunction sourceHtml(q){\n    const refs=q.learning_refs||[],related=q.related_reviews||[],groups=new Map();\n    related.forEach(r=>{if(!groups.has(r.institution))groups.set(r.institution,[]);groups.get(r.institution).push(r)});\n    const rows=[...groups].sort((a,b)=>b[1].length-a[1].length).map(([institution,rs])=>'<details><summary>'+esc(institution)+' · '+rs.length+'개 후기</summary>'+rs.map(r=>'<a href=\"'+esc(r.url)+'\" target=\"_blank\" rel=\"noopener\">'+esc(r.title)+' · '+esc(r.date)+'</a><p class=\"small\">'+esc(r.excerpt)+'</p>').join('')+'</details>').join('');\n    return (refs.length?'<b>교재 찾아보기</b><p>'+refs.map(r=>'<a href=\"'+esc(r.url)+'\" target=\"_blank\">'+esc(r.topic)+' · 페이지 색인</a>').join('')+'</p>':'')+'<b>이 문제의 제작 출처 · '+esc(q.origin)+'</b><p>'+esc(q.clue)+'</p>'+q.source_details.map(r=>'<a href=\"'+esc(r.url)+'\" target=\"_blank\" rel=\"noopener\">'+esc(r.institution)+' · '+esc(r.title)+'</a>').join('')+(related.length?'<hr><b>같은 개념을 언급한 다른 후기</b><p class=\"small muted\">'+groups.size+'개 기관 · '+related.length+'개 후기. 같은 연습문제가 그대로 출제됐다는 뜻은 아닙니다.</p>'+rows:'');\n}\nfunction frequencyHtml(q){\n    const n=q.frequency?.minimum_count;\n    return Number.isInteger(n)&&n>0?'<p>개념 출제 <strong>'+n+'회 이상</strong></p>':'';\n}\nfunction practiceOptionReasons(q,answer){const rs=q.option_explanations||[];return rs.length?'<h3>보기별 해설</h3>'+rs.map((r,i)=>'<details '+(answer===i?'open':'')+'><summary>'+(i+1)+'번 '+(i===q.answer?'· 정답':answer===i?'· 내가 고른 오답':'')+'</summary><p>'+proseMath(r)+'</p></details>').join(''):'';}\nfunction practiceVerifiedRefs(q){return (q.verified_references||[]).length?'<h3>확인한 교재 근거</h3>'+q.verified_references.map(r=>'<a href=\"'+esc(r.url)+'\" target=\"_blank\">'+esc(r.book)+' · PDF p.'+r.page+' · '+esc(r.section)+'</a><p class=\"small muted\">'+esc(r.scope)+'</p>').join(''):'';}\nfunction render(){let q=Q.get(session.ids[session.index]),reveal=canReveal(q),done=session.ids.filter(id=>answerPresent(Q.get(id))).length;$('position').textContent=`${session.index+1} / ${session.ids.length}`;$('sessionLabel').textContent=session.submitted?'채점 후 복습':session.mode==='exam'?'시험 모드':'연습 모드';$('progress').style.width=`${100*done/session.ids.length}%`;$('progress').parentElement.setAttribute('aria-valuenow',Math.round(100*done/session.ids.length));$('qtags').innerHTML=[q.id,q.topic,q.type,q.origin,q.material].map(t=>`<span class=\"pill\">${esc(t)}</span>`).join('');$('qtitle').textContent=q.title;$('questionFrequency').innerHTML=frequencyHtml(q);$('questionFrequency').hidden=!$('questionFrequency').innerHTML;$('stem').innerHTML=proseMath(q.display_stem||q.stem);$('questionFigure').hidden=!q.visual_html;$('questionFigure').innerHTML=q.visual_html||'';renderCode(q);$('promptMath').hidden=!q.formula_prompt;$('promptMath').innerHTML=q.formula_prompt||'';$('star').textContent=stars.has(q.id)?'★ 복습 표시됨':'☆ 복습 표시';$('star').setAttribute('aria-pressed',stars.has(q.id));\nlet written=q.type!=='객관식';$('writtenBox').hidden=!written;$('choices').hidden=written;$('written').value=written?(session.answers[q.id]||''):'';$('written').disabled=session.submitted;\n$('choices').innerHTML=written?'':q.options.map((o,i)=>`<label class=\"choice ${reveal&&i===q.answer?'correct':''} ${reveal&&session.answers[q.id]===i&&i!==q.answer?'wrong':''}\"><input type=\"radio\" name=\"choice\" value=\"${i}\" ${session.answers[q.id]===i?'checked':''} ${reveal?'disabled':''}><span class=\"option-body\"><b>${i+1}.</b> ${proseMath(o)}${reveal&&i===q.answer?' <b>✓ 정답</b>':''}${q.option_visuals?.[i]?'<span class=\"option-graphic\">'+q.option_visuals[i]+'</span>':''}</span></label>`).join('');\ndocument.querySelectorAll('input[name=choice]').forEach(e=>e.onchange=()=>{session.answers[q.id]=Number(e.value);persist();render()});$('prev').disabled=session.index===0;$('next').disabled=session.index===session.ids.length-1;$('check').hidden=session.mode==='exam'&&!session.submitted;$('check').disabled=reveal;$('check').textContent=written?'모범답안·체크리스트 확인':'정답·해설 확인';$('questionStatus').textContent=reveal?'해설이 공개된 문제입니다. 새 시험 또는 오답 다시 풀기로 재도전할 수 있습니다.':session.mode==='exam'?'시험 중에는 답안을 제출할 때까지 정답을 공개하지 않습니다.':'';\n$('explanation').hidden=!reveal;if(reveal){let correct=session.answers[q.id]===q.answer;$('answerLabel').textContent=written?'모범 답안':`${correct?'정답입니다':'오답'+(!answerPresent(q)?' (미응답)':'')} · 정답 ${q.answer+1}번`;$('answerLabel').className='answer '+(written?'':correct?'correctText':'wrongText');$('explainText').innerHTML=proseMath(q.explanation)+practiceOptionReasons(q,session.answers[q.id])+practiceVerifiedRefs(q);$('solutionMath').hidden=!q.formula_solution;$('solutionMath').innerHTML=q.formula_solution||'';$('conceptText').innerHTML=proseMath(q.concept);$('conceptText').hidden=written;$('conceptHeading').hidden=written;$('rubricBox').hidden=!written;$('rubric').innerHTML=(q.rubric||[]).map(t=>`<label><input type=\"checkbox\"> ${esc(t)}</label>`).join('');document.querySelectorAll('#selfgrade button').forEach(b=>{b.setAttribute('aria-pressed',session.self[q.id]===Number(b.dataset.score));b.onclick=()=>{session.self[q.id]=Number(b.dataset.score);persist();render();if(session.submitted)showResult()}});$('sources').innerHTML=sourceHtml(q);}\n$('answeredCount').textContent=`응답 ${done}/${session.ids.length} · 객관식 자동채점 / 서술형 별도 자기평가`;$('finish').hidden=session.submitted;$('nav').innerHTML=session.ids.map((id,i)=>{let n=Q.get(id),rev=canReveal(n),cls=i===session.index?'current ':'';if(rev&&n.type==='객관식')cls+=session.answers[id]===n.answer?'right':'incorrect';else if(answerPresent(n))cls+='answered';return `<button class=\"${cls}\" data-index=\"${i}\" aria-label=\"${i+1}번 ${esc(n.title)}\">${i+1}</button>`}).join('');document.querySelectorAll('#nav button').forEach(b=>b.onclick=()=>{session.index=Number(b.dataset.index);persist();render()});$('saveStatus').textContent=storageOK?'이 브라우저에 자동 저장됨':'이 창에서만 풀이 유지';}\nfunction finish(auto=false){if(!session||session.submitted)return;session.submitted=true;session.finishedAt=Date.now();session.auto=auto;session.ids.map(id=>Q.get(id)).forEach(assess);persist();render();showResult();$('result').scrollIntoView({behavior:'smooth'});}\nfunction showResult(){let qs=session.ids.map(id=>Q.get(id)),mc=qs.filter(q=>q.type==='객관식'),right=mc.filter(q=>session.answers[q.id]===q.answer),wrong=mc.filter(q=>session.answers[q.id]!==q.answer),fr=qs.filter(q=>q.type!=='객관식'),graded=fr.filter(q=>Number.isInteger(session.self[q.id]));let counts=topics.map(t=>{let a=mc.filter(q=>q.topic===t);return {t,n:a.length,r:a.filter(q=>session.answers[q.id]===q.answer).length}}).filter(x=>x.n);$('result').hidden=false;$('result').innerHTML=`<div class=\"row between\"><div><div class=\"muted\">${session.auto?'제한시간 종료 · 자동 제출':'답안 제출 완료'}</div><div class=\"score\">${mc.length?Math.round(right.length/mc.length*100)+'점':'서술형 풀이'}</div><p>객관식 ${right.length}/${mc.length} 정답 · 미응답 포함 오답 ${wrong.length}개<br>서술형 ${fr.length}개 · 자기평가 완료 ${graded.length}개${graded.length?' · '+graded.reduce((n,q)=>n+session.self[q.id],0)+'/'+graded.length*2+'점':''}</p></div><div class=\"row\"><button id=\"retryWrong\" ${wrong.length?'':'disabled'} class=\"primary\">이번 오답 ${wrong.length}개 다시 풀기</button><button id=\"exportResult\">풀이 기록 내려받기</button></div></div><table class=\"reviewtable\"><thead><tr><th>객관식 주제</th><th>정답 / 전체</th></tr></thead><tbody>${counts.map(x=>`<tr><td>${esc(x.t)}</td><td>${x.r} / ${x.n}</td></tr>`).join('')}</tbody></table><p class=\"small muted\">서술형의 자기평가는 객관식 점수에 합산하지 않습니다. 아래 문제 이동에서 각 문항의 해설을 확인할 수 있습니다.</p>`;$('retryWrong').onclick=()=>{session={ids:shuffled(wrong.map(q=>q.id)),index:0,mode:'practice',answers:{},checked:{},self:{},submitted:false,startedAt:Date.now(),endAt:null};persist();showSession()};$('exportResult').onclick=()=>{let out={title:BANK.title,finishedAt:new Date(session.finishedAt).toISOString(),results:qs.map(q=>({id:q.id,title:q.title,type:q.type,answer:session.answers[q.id]??null,correct:q.type==='객관식'?session.answers[q.id]===q.answer:null,self:session.self[q.id]??null}))};let u=URL.createObjectURL(new Blob([JSON.stringify(out,null,2)],{type:'application/json'}));let a=document.createElement('a');a.href=u;a.download='필기연습_풀이기록.json';a.click();URL.revokeObjectURL(u);};}\nfunction tick(){if(!session||$('workspace').hidden)return;if(session.mode!=='exam'){$('timer').textContent='시간 제한 없음';return;}let remain=session.submitted?Math.max(0,session.endAt-sessi